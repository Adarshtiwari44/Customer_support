# Groq API Key (Get a free key from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Brand Identifier
BRAND_ID=AmazonHelp

# LLM Model (Groq LLaMA 3.3 70B recommended)
LLM_MODEL=llama-3.3-70b-versatile

# Paths
DATASET_PATH=data/raw/twcs.csv
GOLDEN_SET_PATH=data/schemas/golden_set_final.jsonl

# Pipeline Thresholds
INTENT_CONFIDENCE_THRESHOLD=0.70
EVIDENCE_THRESHOLD=0.60
RETRIEVAL_TOP_K=3
